{
  "name": "nxweb",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node test/runtime/all.mts",
    "kit:diagrams": "node src/kit/host/gen.mts",
    "kit:check": "node src/kit/host/gen.mts --check",
    "kit:test": "node test/kit/run.mts",
    "guests:build": "python3 tools/build_guests.py",
    "guests:check": "python3 tools/build_guests.py --check",
    "guests:run": "python3 tools/ref_run.py",
    "a64:build": "node src/a64/host/build.mts",
    "a64:fuzz": "npm run -s a64:build && python3 test/a64/fuzz.py",
    "a64:guests:build": "python3 test/a64/guests/build.py",
    "a64:guests": "npm run -s a64:build && npm run -s a64:guests:build && node test/a64/guests_run.ts; a=$?; echo '--- again with budget=50 (forced preemption) ---'; node test/a64/guests_run.ts --budget 50 --quiet; b=$?; echo '--- again without wasm tail calls ---'; node test/a64/guests_run.ts --notail --quiet; c=$?; echo '--- again on a shared memory (atomic exclusives) ---'; node test/a64/guests_run.ts --shared --quiet; d=$?; echo '--- translator feature tests ---'; node test/a64/extra_run.ts; e=$?; exit $((a|b|c|d|e))",
    "a64:speed": "npm run -s a64:build && node test/a64/guests_run.ts --speed",
    "loader:build": "node src/loader/host/build.mts",
    "loader:test": "node test/loader/run.mts",
    "kernel:build": "asc src/kernel/index.ts -o build/kernel/kernel.wasm -O2 --runtime stub --initialMemory 1536",
    "kernel:test": "node test/kernel/run.mts",
    "a64:browser": "npm run -s a64:build && esbuild test/a64/browser/worker.ts --bundle --format=iife --outfile=build/a64/browser/worker.js --log-level=warning && node test/a64/browser/run.ts",
    "gfx:names": "node src/gfx/host/gen_names.mts",
    "gfx:build": "node src/gfx/host/build.mts",
    "gfx:test": "node test/gfx/run.mts",
    "gfx:demo": "node test/gfx/demo_serve.mts",
    "a64:big": "npm run -s a64:build && python3 test/a64/guests/build.py --big && node test/a64/guests_run.ts --dir test/a64/guests/out_big --speed --mem",
    "rt:build": "node src/runtime/host/build.mts",
    "rt:test": "node --expose-gc test/runtime/run.mts",
    "rt:browser": "node test/runtime/browser.mts",
    "rt:guard": "node test/runtime/guard_bench.mts",
    "a64:mem64": "node --experimental-wasm-memory64 test/a64/mem64_bench.mts",
    "shaders:naga": "cargo build --release --target wasm32-unknown-unknown --manifest-path tools/shaders/naga_wasm/Cargo.toml --target-dir build/shaders/naga_target && cp build/shaders/naga_target/wasm32-unknown-unknown/release/nx_naga.wasm build/shaders/nx_naga.wasm",
    "shaders:asm": "python3 tools/shaders/maxwell_asm.py build/shaders/maxwell",
    "shaders:xlate": "python3 tools/shaders/xlate.py build/shaders/maxwell/corpus.json build/shaders/maxwell/spv",
    "shaders:lib": "node tools/shaders/build_lib.mts --spv build/shaders/maxwell/spv -o build/shaders/maxwell.nxsl --report build/shaders/maxwell.report.json",
    "shaders:xlate-wasm": "sh tools/shaders/build_xlate_wasm.sh",
    "shaders:test": "node test/shaders/run.mts",
    "a64:extra": "npm run -s a64:build && node test/a64/extra_run.ts",
    "web:build": "node web/build.mts",
    "web": "node web/serve.mts",
    "web:shots": "node web/shots.mts",
    "fs:build": "asc src/fs/index.ts -o build/fs/fs.wasm -O2 --runtime stub",
    "fs:test": "node test/fs/run.mts",
    "fs:browser": "node test/fs/browser.mts",
    "hle:names": "python3 tools/hle_names.py",
    "hle:check": "python3 tools/hle_names.py --check",
    "hle:build": "node src/hle/host/build.mts",
    "hle:test": "node test/hle/run.mts",
    "audio:names": "node src/audio/host/gen_names.mts /home/user/nxnative/dm/host",
    "audio:build": "asc src/audio/index.ts -o build/audio/audio.wasm -O2 --runtime stub",
    "audio:test": "node test/audio/run.mts",
    "audio:browser": "node test/audio/browser.mts",
    "doom:fetch": "sh tools/doom/fetch.sh",
    "doom:test": "node --expose-gc test/doom/run.mts",
    "doom:browser": "node test/doom/browser.mts",
    "prepare:build": "node src/prepare/host/build.mts",
    "prepare:profiles": "python3 tools/prepare/convert_profiles.py",
    "prepare:profiles:check": "python3 tools/prepare/convert_profiles.py --check",
    "prepare:writes": "python3 tools/prepare/gen_match_writes.py --fuzz 400000",
    "prepare:writes:check": "python3 tools/prepare/gen_match_writes.py --check",
    "prepare:test": "node test/prepare/run.mts",
    "prepare:measure": "node test/prepare/measure.mts",
    "prepare:browser": "node test/prepare/browser.mts",
    "prepare:web": "node web/prepare_build.mts --serve"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "assemblyscript": "^0.28.20",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fzstd": "^0.1.1"
  }
}
