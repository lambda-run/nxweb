// Generates src/gfx/gen/names.ts from nxnative's dm/gfx/nvn/names.txt (the full NVN name list, 743 names) and from the
// `case F.<name>` lines of src/gfx/dispatch.ts:
//   NAMES       the names, sorted, as one blob for nvn_lookup's binary search
//   namespace F one id per name (its line in names.txt), what nvn_call switches on
//   STATUS      per id: 0 unimplemented (red line once, returns 0), 1 implemented, 2 empty by design (NOPS below)
//   ABI         per id: how many float arguments it reads and whether it returns a float (nvn_abi)
// `node src/gfx/host/gen_names.mts [path/to/names.txt]` writes it; the copy of the list is src/gfx/names.txt.
import { readFileSync, writeFileSync, existsSync, copyFileSync } from "node:fs";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const DIR = join(dirname(fileURLToPath(import.meta.url)), "..");
const LIST = join(DIR, "names.txt");

// Empty by design, as in nxnative (hle_nvn.c g_nops): debug markers and hints with no effect on the picture
export const NOPS = [
  "nvnCommandBufferSetPatchSize", "nvnCommandBufferSetDepthBounds", "nvnCommandBufferSetShaderScratchMemory", "nvnCommandBufferPushDebugGroupDynamic",
  "nvnCommandBufferPopDebugGroup", "nvnCommandBufferInsertDebugMarkerDynamic", "nvnCommandBufferInsertDebugMarker", "nvnCommandBufferPushDebugGroup",
  "nvnCommandBufferPushDebugGroupStatic", "nvnCommandBufferPopDebugGroupId", "nvnCommandBufferInsertDebugMarkerStatic",
];

export function generate(): { source: string; total: number; implemented: number; nops: number } {
  const names = readFileSync(LIST, "utf8").split("\n").map(s => s.trim()).filter(Boolean);
  const disp = existsSync(join(DIR, "dispatch.ts")) ? readFileSync(join(DIR, "dispatch.ts"), "utf8") : "";
  const impl = new Set([...disp.matchAll(/case F\.(nvn\w+):/g)].map(m => m[1]));
  for (const n of impl) if (!names.includes(n)) throw new Error(`dispatch.ts implements ${n}, which is not in names.txt`);
  for (const n of NOPS) { if (!names.includes(n)) throw new Error(`${n} (NOPS) is not in names.txt`); if (impl.has(n)) throw new Error(`${n} is implemented and also listed as empty`); }
  const order = names.map((n, i) => ({ n, i })).sort((a, b) => (a.n < b.n ? -1 : a.n > b.n ? 1 : 0));
  // blob: per sorted name { u16 id, u8 length, bytes }, and an offset table for the binary search
  const bytes: number[] = [], offs: number[] = [];
  for (const { n, i } of order) { offs.push(bytes.length); bytes.push(i & 0xff, i >> 8, n.length, ...Buffer.from(n, "latin1")); }
  const rows = (a: number[], per: number) => { const r: string[] = []; for (let k = 0; k < a.length; k += per) r.push("  " + a.slice(k, k + per).join(", ")); return r.join(",\n"); };
  const status = names.map(n => (impl.has(n) ? 1 : NOPS.includes(n) ? 2 : 0));
  // ABI: how many d registers each implemented function reads (the highest FL(a, i) in its case, + 1), and whether it
  // returns a float in d0 (RETF). Cases that share a body share its numbers
  const abiOf = new Map<string, number>(), labels = [...disp.matchAll(/case F\.(nvn\w+):/g)];
  let group: string[] = [];
  labels.forEach((m, k) => {
    const body = disp.slice(m.index! + m[0].length, k + 1 < labels.length ? labels[k + 1].index! : disp.indexOf("\n  }\n  const st = status(fn);"));
    group.push(m[1]);
    if (!body.trim()) return;
    const fl = [...body.matchAll(/\bFL\(a, (\d)\)/g)].reduce((n, x) => Math.max(n, Number(x[1]) + 1), 0);
    for (const n of group) abiOf.set(n, fl | (/\bRETF\(/.test(body) ? 16 : 0));
    group = [];
  });
  const abi = names.map(n => abiOf.get(n) ?? 0);
  let s = `// GENERATED by \`node src/gfx/host/gen_names.mts\` from src/gfx/names.txt and src/gfx/dispatch.ts. Do not edit.\n\n`;
  s += `export const NVN_NFUNC: i32 = ${names.length};\n`;
  s += `export const NAMES: usize = memory.data<u8>([\n${rows(bytes, 32)}\n]);\n`;
  s += `export const NAME_OFFS: usize = memory.data<u16>([\n${rows(offs, 24)}\n]);\n`;
  s += `export const STATUS: usize = memory.data<u8>([\n${rows(status, 48)}\n]);\n`;
  s += `// per id: bits 0-3 the number of float arguments read (d0..), bit 4 the result is a float in d0\nexport const ABI: usize = memory.data<u8>([\n${rows(abi, 48)}\n]);\n`;
  s += `export namespace F {\n${names.map((n, i) => `  export const ${n}: i32 = ${i};\n`).join("")}}\n`;
  return { source: s, total: names.length, implemented: impl.size, nops: NOPS.length };
}

export const OUT = join(DIR, "gen", "names.ts");
if (process.argv[1] && import.meta.filename === process.argv[1]) {
  if (process.argv[2]) copyFileSync(process.argv[2], LIST);
  const g = generate();
  writeFileSync(OUT, g.source);
  console.log(`gfx names: ${g.total} names, ${g.implemented} implemented + ${g.nops} empty by design, ${g.total - g.implemented - g.nops} unimplemented (red stub)`);
}
