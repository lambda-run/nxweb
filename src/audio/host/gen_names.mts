// One-off generator of src/audio/names.ts: the nn::audio and nn::codec names nxnative takes over, in the order of
// dm/host/hle_audio.c, hle_audren.c and hle_codec.c.
//   node src/audio/host/gen_names.mts /path/to/nxnative/dm/host
// The result is committed; test/audio checks it against the three files when the reference clone is present.
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

export const FILES = ["hle_audio.c", "hle_audren.c", "hle_codec.c"];

export function namesOf(src: string): { mangled: string; ident: string }[] {
  const out: { mangled: string; ident: string }[] = [];
  const re = /HLE_FORCE(?:_BIG)?\("(_Z\w+)",\s*"(?:[^"\\]|\\.)*",\s*[\w \*]+?,\s*h_(\w+)/g;
  for (let m; (m = re.exec(src));) out.push({ mangled: m[1], ident: m[2] });
  return out;
}
export function allNames(dir: string): { mangled: string; ident: string; file: string }[] {
  return FILES.flatMap(f => namesOf(readFileSync(join(dir, f), "utf8")).map(n => ({ ...n, file: f })));
}

if (process.argv[1] && import.meta.filename === process.argv[1]) {
  const names = allNames(process.argv[2]);
  let s = "// GENERATED by src/audio/host/gen_names.mts from nxnative dm/host/hle_audio.c, hle_audren.c and hle_codec.c:\n";
  s += "// every HLE_FORCE name of those files, in their order. Fn.<x> is nxnative's h_<x>.\n\n";
  s += `export const FN_COUNT: u32 = ${names.length};\n\nexport const enum Fn {\n  None = 0,\n`;
  let file = "";
  names.forEach((n, i) => { if (n.file !== file) { file = n.file; s += `  // ${file}\n`; } s += `  ${n.ident} = ${i + 1},\n`; });
  s += `}\n\n// NAMES[fn - 1]\nexport const NAMES: StaticArray<string> = [\n${names.map(n => `  "${n.mangled}",\n`).join("")}];\n`;
  writeFileSync(join(import.meta.dirname, "..", "names.ts"), s);
  console.log(`names.ts: ${names.length} names`);
}
