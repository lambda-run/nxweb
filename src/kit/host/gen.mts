// Generates, from src/kit/defs/*.json (the single source of truth for every machine):
//   src/kit/gen/tables.ts      the tables and the state/event constants the AssemblyScript code compiles in
//   docs/machines/<name>.md    one Mermaid stateDiagram-v2 per machine
// `node src/kit/host/gen.mts` writes them, `node src/kit/host/gen.mts --check` fails if any is out of date.
import { readFileSync, writeFileSync, readdirSync, existsSync, mkdirSync, rmSync } from "node:fs";
import { join, relative } from "node:path";
import { KIT_DIR, loadDefs, buildBlob, pascal, dataMax, DATA_ANY, type MachineDef } from "./defs.mts";

const ROOT = join(KIT_DIR, "..", "..");
const TABLES = join(KIT_DIR, "gen", "tables.ts");
const DOCS = join(ROOT, "docs", "machines");
const MARK = "<!-- GENERATED by `npm run kit:diagrams`";

export function tablesSource(defs: MachineDef[]): string {
  const blob = buildBlob(defs);
  const rows: string[] = [];
  for (let i = 0; i < blob.bytes.length; i += 24) rows.push("  " + Array.from(blob.bytes.subarray(i, i + 24)).join(", "));
  let s = `// GENERATED by \`npm run kit:diagrams\` from src/kit/defs/*.json. Do not edit: change the definition and run it again.
// Layout of BLOB: src/kit/host/defs.mts (buildBlob).

export const MACHINE_COUNT: u8 = ${defs.length};
export const HITS_SIZE: u32 = ${blob.hitsSize};
export const BLOB: usize = memory.data<u8>([
${rows.join(",\n")}
]);
export const HITS: usize = memory.data(${blob.hitsSize});
`;
  for (const d of defs) {
    const P = pascal(d.name);
    s += `\n// ${d.name} (src/kit/defs/${d.name}.json, docs/machines/${d.name}.md)\n`;
    s += `export const ${d.name.toUpperCase()}: u8 = ${d.id};\n`;
    s += `export namespace ${P}S {\n${d.states.map((n, i) => `  export const ${n}: u8 = ${i};\n`).join("")}}\n`;
    s += `export namespace ${P}E {\n${d.events.map((n, i) => `  export const ${n}: u8 = ${i};\n`).join("")}}\n`;
    for (const sd of Object.values(d.data)) if (sd.values) {
      s += `export namespace ${P}${sd.name[0].toUpperCase()}${sd.name.slice(1)} {\n${sd.values.map((n, i) => `  export const ${n}: u64 = ${i + 1};\n`).join("")}}\n`;
    }
  }
  return s;
}

export function diagramSource(d: MachineDef): string {
  const L: string[] = [];
  L.push(`# ${d.name}`, "", `${MARK} from src/kit/defs/${d.name}.json. Do not edit. -->`, "", d.doc, "");
  L.push("```mermaid", "stateDiagram-v2", `    [*] --> ${d.initial}`);
  for (const [f, e, to] of d.transitions) L.push(`    ${f} --> ${to}: ${e}`);
  for (const s of d.final) L.push(`    ${s} --> [*]`);
  for (const [s, sd] of Object.entries(d.data)) L.push(`    note right of ${s}: carries ${sd.name}${sd.values ? " (" + sd.values.join(", ") + ")" : ""}`);
  L.push("```", "");
  L.push(`Machine id ${d.id}. Any (state, event) pair not listed below is refused: the state stays, \`step\` returns false and a \`[RED] \` line is logged.`, "");
  L.push("| # | State | Carries |", "|---|---|---|");
  d.states.forEach((s, i) => {
    const sd = d.data[s], m = dataMax(d, s);
    const tags = [s === d.initial ? "initial" : "", d.final.includes(s) ? "final" : ""].filter(Boolean).join(", ");
    const carries = !sd ? "" : m === DATA_ANY ? `${sd.name}: ${sd.type}` : `${sd.name}: ${sd.values!.map((v, k) => `${k + 1} ${v}`).join(", ")}`;
    L.push(`| ${i} | ${s}${tags ? ` (${tags})` : ""} | ${carries} |`);
  });
  L.push("", "| From | Event (#) | To |", "|---|---|---|");
  for (const [f, e, to] of d.transitions) L.push(`| ${f} | ${e} (${d.events.indexOf(e)}) | ${to} |`);
  return L.join("\n") + "\n";
}

// Every generated file with the content it must have, and the generated diagrams that no longer have a machine
export function plan(defs: MachineDef[]): { files: Map<string, string>; stale: string[] } {
  const files = new Map<string, string>([[TABLES, tablesSource(defs)]]);
  for (const d of defs) files.set(join(DOCS, d.name + ".md"), diagramSource(d));
  const stale = !existsSync(DOCS) ? [] : readdirSync(DOCS).filter(f => f.endsWith(".md")).map(f => join(DOCS, f))
    .filter(p => !files.has(p) && readFileSync(p, "utf8").includes(MARK));
  return { files, stale };
}

// The problems a check finds (empty: everything is up to date)
export function check(defs = loadDefs()): string[] {
  const { files, stale } = plan(defs), bad: string[] = [];
  for (const [p, want] of files) {
    if (!existsSync(p)) bad.push(`${relative(ROOT, p)}: missing`);
    else if (readFileSync(p, "utf8") !== want) bad.push(`${relative(ROOT, p)}: out of date`);
  }
  for (const p of stale) bad.push(`${relative(ROOT, p)}: no machine of this name is defined any more`);
  return bad;
}

if (process.argv[1] && import.meta.filename === process.argv[1]) {
  const defs = loadDefs();
  if (process.argv.includes("--check")) {
    const bad = check(defs);
    for (const b of bad) console.error(`[RED] kit:check: ${b}`);
    if (bad.length) { console.error("kit:check: run `npm run kit:diagrams` and commit the result"); process.exit(1); }
    console.log(`kit:check: ${defs.length} machines, tables and diagrams are up to date`);
  } else {
    const { files, stale } = plan(defs);
    mkdirSync(join(KIT_DIR, "gen"), { recursive: true }); mkdirSync(DOCS, { recursive: true });
    for (const [p, want] of files) {
      const same = existsSync(p) && readFileSync(p, "utf8") === want;
      if (!same) writeFileSync(p, want);
      console.log(`${same ? "unchanged" : "wrote    "} ${relative(ROOT, p)}`);
    }
    for (const p of stale) { rmSync(p); console.log(`removed   ${relative(ROOT, p)}`); }
  }
}
