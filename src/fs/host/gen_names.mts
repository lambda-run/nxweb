// One-off generator of src/fs/names.ts: the nn::fs names nxnative takes over, in the order of dm/host/hle_fs.c.
//   node src/fs/host/gen_names.mts /path/to/nxnative/dm/host/hle_fs.c
// The result is committed; test/fs checks it against hle_fs.c when the reference clone is present.
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

export function namesOf(src: string): { mangled: string; ident: string }[] {
  const out: { mangled: string; ident: string }[] = [];
  const re = /HLE(?:_FORCE)?\("(_Z\w+)",\s*"(?:[^"\\]|\\.)*",\s*[\w ]+?,\s*h_fs_(\w+)/g;
  for (let m; (m = re.exec(src));) out.push({ mangled: m[1], ident: m[2] });
  return out;
}

if (process.argv[1] && import.meta.filename === process.argv[1]) {
  const names = namesOf(readFileSync(process.argv[2], "utf8"));
  let s = "// GENERATED by src/fs/host/gen_names.mts from nxnative dm/host/hle_fs.c: every HLE / HLE_FORCE name of that file, in its order.\n";
  s += "// Fn.<x> is nxnative's h_fs_<x>.\n\n";
  s += `export const FN_COUNT: u32 = ${names.length};\n\nexport const enum Fn {\n  None = 0,\n${names.map((n, i) => `  ${n.ident} = ${i + 1},\n`).join("")}}\n\n`;
  s += `// NAMES[fn - 1]\nexport const NAMES: StaticArray<string> = [\n${names.map(n => `  "${n.mangled}",\n`).join("")}];\n`;
  writeFileSync(join(import.meta.dirname, "..", "names.ts"), s);
  console.log(`names.ts: ${names.length} names`);
}
