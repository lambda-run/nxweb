// Builds the runtime's test modules (clang aarch64 -> ld.lld -> tools/elf2nso.py, LZ4 compressed with hashes: the
// loader's toolchain and linker script) into build/runtime/guests, and loads everything a test run needs.
import { execFileSync, spawnSync } from "node:child_process";
import { readFileSync, readdirSync, mkdirSync, existsSync, writeFileSync, statSync, copyFileSync } from "node:fs";
import { join } from "node:path";
import { ROOT, OUT, build } from "../../src/runtime/host/build.mts";
import type { CorpusGuest } from "./cases.ts";
import type { MoreEnv } from "./more_cases.ts";
import { nodeFileStore } from "../a64/cache_node.ts";
import { NodeStorage } from "../../src/glue/fs_dev_node.ts";
import { checkBuilt } from "../../src/runtime/host/build.mts";
import { rmSync } from "node:fs";

export { ROOT, OUT, build };
export const GUESTS = join(OUT, "guests");
const SRC = join(ROOT, "test", "runtime", "src");
const CFLAGS = ["--target=aarch64-none-elf", "-fPIC", "-ffreestanding", "-nostdlib", "-O2", "-mcpu=cortex-a57", "-mno-outline-atomics",
  "-fvisibility=hidden", "-fsemantic-interposition", "-fno-asynchronous-unwind-tables", "-fno-unwind-tables", "-Wall", "-Wno-unused-parameter", "-Wno-unused-function"];
const LDFLAGS = ["-shared", "-z", "max-page-size=4096", "-z", "norelro", "--build-id=sha1", "--hash-style=both", "-T", join(ROOT, "test", "loader", "src", "module.ld")];
const run = (cmd: string, args: string[]) => execFileSync(cmd, args, { cwd: ROOT, stdio: ["ignore", "inherit", "inherit"] });

// name -> source file and extra compiler flags
export const MODULES: Record<string, [src: string, ...flags: string[]]> = {
  hello: ["hello.c"], two_main: ["two_main.c"], two_lib: ["two_lib.c"], threads: ["threads.c"], race: ["race.c"], heap: ["heap.c"],
  host_main: ["host_main.c"], host_lib: ["host_lib.c"], argsg: ["argsg.c"], pads: ["pads.c"], tone: ["tone.c"], audren: ["audren.c", "-fno-builtin"], stress_threads: ["stress_threads.c"], stress_mem: ["stress_mem.c"], stress_ro: ["stress_ro.c"],
  fsg: ["fsg.c"], hleg: ["hleg.c"], ro_main: ["ro_main.c"], fini: ["fini.c"], clock: ["clock.c"], fault_null: ["fault.c", "-DMODE=6"], fault_host: ["fault.c", "-DMODE=7"],
  fault_jump: ["fault.c", "-DMODE=1"], fault_undef: ["fault.c", "-DMODE=2"], fault_load: ["fault.c", "-DMODE=3"], fault_stack: ["fault.c", "-DMODE=4"], break: ["fault.c", "-DMODE=5"],
};

// nxnative's nvn.h is not in this repository: the graphics guests include it from the reference clone
// (NXNATIVE_NVN_INCLUDE overrides the directory). Without it they are not built and their tests are skipped.
export const NXNATIVE = process.env.NXNATIVE ?? "/home/user/nxnative";
export const NVN_INCLUDE = process.env.NXNATIVE_NVN_INCLUDE ?? join(NXNATIVE, "dm", "gfx", "nvn", "include");
export const GFX_MODULES: Record<string, [src: string, ...flags: string[]]> = { cube: ["cube.c"], cube2: ["cube2.c"], mx: ["mx.c"], mx_bad: ["mx.c", "-DBAD"], syncg: ["syncg.c"], stress_gfx: ["stress_gfx.c"] };
// The hand-assembled Maxwell programs of tools/shaders (python only), as C arrays for the mx guests, and their keys
export const MAXWELL = join(OUT, "maxwell");
export function maxwellBlobs(): void {
  run("python3", [join(ROOT, "tools", "shaders", "maxwell_asm.py"), MAXWELL]);
  let h = "// generated by test/runtime/harness.mts from tools/shaders/maxwell_asm.py: hand-assembled Maxwell programs\n";
  for (const name of ["vs_quad_ubo", "ps_tex_tint"]) for (const ext of ["code", "ctl"])
    h += `static const u8 mx_${name}_${ext}[] = { ${Array.from(readFileSync(join(MAXWELL, `${name}.${ext}`))).join(",")} };\n`;
  writeFileSync(join(GUESTS, "maxwell_blobs.h"), h);
}
// What the shader tests can use of the shader chain's build outputs (tools/shaders; dotnet, cargo and the nxnative
// checkout are needed to build them, so they may be absent): the offline library and the in-page translator
export const SHADER_OUT = join(ROOT, "build", "shaders");
export function shaderArtifacts(): { library: boolean; translator: boolean; why: string } {
  const has = (cmd: string) => { try { execFileSync(cmd, ["--version"], { stdio: "ignore" }); return true; } catch { return false; } };
  const lib = () => existsSync(join(SHADER_OUT, "maxwell.nxsl")), tr = () => existsSync(join(SHADER_OUT, "xlate_wasm", "_framework", "dotnet.js")) && existsSync(join(SHADER_OUT, "nx_naga.wasm"));
  const npm = (script: string) => { try { execFileSync("npm", ["run", "-s", script], { cwd: ROOT, stdio: ["ignore", "ignore", "inherit"] }); return true; } catch { return false; } };
  const nx = existsSync(join(NXNATIVE, "dm", "gfx", "tools", "dmsh_xlate"));
  let why = "";
  if ((!lib() || !tr()) && process.env.RT_SHADERS_BUILD !== "0") {
    if (!has("dotnet") || !nx) why = `dotnet is not on PATH or the nxnative checkout (NXNATIVE) is not there`;
    else {
      if (!existsSync(join(SHADER_OUT, "nx_naga.wasm")) && (!has("cargo") || !npm("shaders:naga"))) why = "naga could not be built as WebAssembly (cargo with the wasm32-unknown-unknown target)";
      else {
        if (!lib()) { npm("shaders:asm") && npm("shaders:xlate") && npm("shaders:lib"); }
        if (!tr()) npm("shaders:xlate-wasm");
      }
    }
  }
  return { library: lib(), translator: tr(), why };
}
export const haveNvn = (): boolean => existsSync(join(NVN_INCLUDE, "nvn.h"));

// Modules also written with ZBIC segments (NSO flag bit 7, system 22.0.0 on) as <name>_zbic.nso: by the reference
// codec when the `zbic` Python package is installed, else by elf2nso.py's own small compressor (--zbic-own).
// hello_zbicfix.nso is test/runtime/fixtures/hello_zbic.nso, a file the reference codec made that is committed, so
// that a stream with ZBIC's own table coding and Huffman literals is loaded and run where the package is missing.
export const ZBIC_MODULES = ["hello", "two_main", "two_lib", "fsg"];
export const ZBIC_FILES = [...ZBIC_MODULES.map(n => n + "_zbic"), "hello_zbicfix"];
let zbicPackage: boolean | undefined;
export const haveZbic = (): boolean => zbicPackage ??= spawnSync("python3", [join(ROOT, "test", "loader", "zbic_ref.py"), "check"], { cwd: ROOT }).status === 0;
// modules stored without compression (elf2nso.py's own LZ4 is Python: too slow for tens of megabytes). large: the
// module far larger than the fixed file staging range; the test fills and compresses it (large_nso.ts)
export const STORED_MODULES: Record<string, [src: string, ...flags: string[]]> = { large: ["large.c"], wide: ["wide.c"] };
// RT_HUGE=1 (Node only): the target size, a 256 MB file with a 512 MB image
export const HUGE = { ro: 252, data: 60, bss: 200, heap: 300 };
if (process.env.RT_HUGE === "1") STORED_MODULES.huge = ["large.c", `-DRO_MB=${HUGE.ro}`, `-DDATA_MB=${HUGE.data}`, `-DBSS_MB=${HUGE.bss}`, `-DHEAP_MB=${HUGE.heap}`];
// modules built as NRO files (loaded at run time through nn::ro)
export const NRO_MODULES: Record<string, string> = { plug: "plug.c" };
export function buildModules(): void {
  mkdirSync(GUESTS, { recursive: true });
  const o = (n: string) => join(GUESTS, n);
  run("clang", [...CFLAGS, "-c", join(SRC, "crt0.S"), "-o", o("crt0.o")]);
  run("clang", [...CFLAGS, "-c", join(SRC, "svc.S"), "-o", o("svc.o")]);
  for (const [name, [src, ...flags]] of Object.entries(MODULES)) {
    run("clang", [...CFLAGS, ...flags, "-c", join(SRC, src), "-o", o(name + ".o")]);
    run("ld.lld", [...LDFLAGS, o("crt0.o"), o(name + ".o"), o("svc.o"), "-o", o(name + ".so")]);
    run("python3", [join(ROOT, "tools", "elf2nso.py"), o(name + ".so"), o(name + ".nso"), "--lz4"]);
    if (ZBIC_MODULES.includes(name)) run("python3", [join(ROOT, "tools", "elf2nso.py"), o(name + ".so"), o(name + "_zbic.nso"), "--zbic", ...(haveZbic() ? [] : ["--zbic-own"])]);
  }
  copyFileSync(join(ROOT, "test", "runtime", "fixtures", "hello_zbic.nso"), o("hello_zbicfix.nso"));
  for (const [name, [src, ...flags]] of Object.entries(STORED_MODULES)) {
    if (existsSync(o(name + ".nso")) && statSync(o(name + ".nso")).mtimeMs > Math.max(...[src, "rt.h", "crt0.S", "svc.S"].map(f => statSync(join(SRC, f)).mtimeMs))) continue;   // 64 MB: built once
    run("clang", [...CFLAGS, ...flags, "-c", join(SRC, src), "-o", o(name + ".o")]);
    run("ld.lld", [...LDFLAGS, o("crt0.o"), o(name + ".o"), o("svc.o"), "-o", o(name + ".so")]);
    run("python3", [join(ROOT, "tools", "elf2nso.py"), o(name + ".so"), o(name + ".nso")]);
    rmSync(o(name + ".o")); rmSync(o(name + ".so"));
  }
  for (const [name, src] of Object.entries(NRO_MODULES)) {
    run("clang", [...CFLAGS, "-c", join(SRC, src), "-o", o(name + ".o")]);
    run("ld.lld", [...LDFLAGS, o("crt0.o"), o(name + ".o"), o("svc.o"), "-o", o(name + ".so")]);
    run("python3", [join(ROOT, "tools", "elf2nso.py"), o(name + ".so"), o(name + ".nro"), "--nro"]);
  }
  romfsImage();
  if (!haveNvn()) { console.error(`[RED] rt: ${join(NVN_INCLUDE, "nvn.h")} not found (set NXNATIVE_NVN_INCLUDE): the graphics guests are not built and their tests are skipped`); return; }
  maxwellBlobs();
  for (const [name, [src, ...flags]] of Object.entries(GFX_MODULES)) {
    run("clang", [...CFLAGS, ...flags, "-I", NVN_INCLUDE, "-I", GUESTS, "-c", join(SRC, src), "-o", o(name + ".o")]);
    run("ld.lld", [...LDFLAGS, o("crt0.o"), o(name + ".o"), o("svc.o"), "-o", o(name + ".so")]);
    run("python3", [join(ROOT, "tools", "elf2nso.py"), o(name + ".so"), o(name + ".nso"), "--lz4"]);
  }
}

export function corpusList(): string[] {
  const dir = join(ROOT, "test", "guests", "out");
  return existsSync(dir) ? readdirSync(dir).filter(f => f.endsWith(".json") && f !== "manifest.json").sort().map(f => f.replace(/\.json$/, "")) : [];
}
// A standard RomFS image for the file-system guest, built by tools/mkromfs.py from a small generated folder
export function romfsImage(): void {
  const dir = join(GUESTS, "romfs_src");
  mkdirSync(join(dir, "data"), { recursive: true });
  const blob = new Uint8Array(100_003);
  let v = 12345; for (let i = 0; i < blob.length; i++) { v = (Math.imul(v, 1103515245) + 12345) >>> 0; blob[i] = v >>> 16; }
  writeFileSync(join(dir, "hello.txt"), "hello from a RomFS image\n");
  writeFileSync(join(dir, "data", "blob.bin"), blob);
  writeFileSync(join(GUESTS, "romfs_blob.bin"), blob);
  run("python3", [join(ROOT, "tools", "mkromfs.py"), "build", dir, join(GUESTS, "romfs.img")]);
}
export const BIG_DIR = join(ROOT, "test", "a64", "guests", "out_big");
// the a64 owner's large generated guest; built here when it is missing (clang and the reference runner are needed)
export function buildBig(): boolean {
  if (existsSync(join(BIG_DIR, "a64_big.O1.json"))) return true;
  try { run("python3", [join(ROOT, "test", "a64", "guests", "build.py"), "--big"]); } catch { console.error("[RED] rt: the large guest could not be built (test/a64/guests/build.py --big): the cache timing is skipped"); }
  return existsSync(join(BIG_DIR, "a64_big.O1.json"));
}
export function loadEnv(): MoreEnv {
  checkBuilt();   // none of the modules was built from other kit tables
  const mod = (n: string) => new WebAssembly.Module(readFileSync(join(OUT, n + ".wasm")));
  const dir = join(ROOT, "test", "guests", "out");
  const corpus: CorpusGuest[] = corpusList().map(name => {
    const side = JSON.parse(readFileSync(join(dir, name + ".json"), "utf8"));
    return { name, side, image: new Uint8Array(readFileSync(join(dir, side.image))), expected: new Uint8Array(readFileSync(join(dir, side.expected_stdout))) };
  });
  return {
    mods: { rt: mod("rt"), kernel: mod("kernel"), loader: mod("loader"), translator: mod("translator"), helpers: mod("helpers"), gfx: mod("gfx"), fs: mod("fs"), hle: mod("hle"), audio: mod("audio") },
    nso: name => new Uint8Array(readFileSync(join(GUESTS, name + ".nso"))),
    file: name => new Uint8Array(readFileSync(join(GUESTS, name))),
    haveGfxGuests: haveNvn(),
    huge: process.env.RT_HUGE === "1" ? { stored: () => new Uint8Array(readFileSync(join(GUESTS, "huge.nso"))), ...HUGE } : undefined,
    profiles: () => readdirSync(join(ROOT, "src", "prepare", "profiles")).filter(f => /^[0-9A-Fa-f]{16}\.json$/.test(f)).map(f => { const p = JSON.parse(readFileSync(join(ROOT, "src", "prepare", "profiles", f), "utf8")); return { id: p.title_id, apply: p.apply, space: p.address_space }; }),
    guardRounds: process.env.RT_GUARD_ROUNDS ? Number(process.env.RT_GUARD_ROUNDS) : undefined,
    corpus,
    rssMb: () => process.memoryUsage().rss / 1e6,
    big: buildBig() ? (() => { const side = JSON.parse(readFileSync(join(BIG_DIR, "a64_big.O1.json"), "utf8")); return { name: "a64_big.O1", side, image: new Uint8Array(readFileSync(join(BIG_DIR, side.image))), expected: new Uint8Array(readFileSync(join(BIG_DIR, side.expected_stdout))) }; })() : undefined,
    shaderLibrary: shaderArtifacts().library ? new Uint8Array(readFileSync(join(SHADER_OUT, "maxwell.nxsl"))) : undefined,
    shaderWhy: shaderArtifacts().why,
    // rom: the image file; saves: container files in a directory that outlives the storage object
    fsStorage: async (name, reset) => {
      const dir = join(OUT, "saves", name);
      if (reset) rmSync(dir, { recursive: true, force: true });
      return new NodeStorage({ rom: join(GUESTS, "romfs.img"), saveDir: dir });
    },
    cacheStore: async name => { const dir = join(OUT, "cache", name); rmSync(dir, { recursive: true, force: true }); return nodeFileStore(dir); },
    // with --expose-gc the figure is after a collection; ArrayBuffers (wasm memories) are in `external`
    heapMb: async () => { const gc = (globalThis as any).gc; if (gc) { for (let i = 0; i < 3; i++) { gc(); await new Promise(r => setTimeout(r, 20)); } } const m = process.memoryUsage(); return (m.heapUsed + m.external) / 1e6; },
  };
}
